# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Optional: override models (defaults in config.py)
# ANTHROPIC_FILTER_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_SYNTHESIS_MODEL=claude-3-5-sonnet-20241022

# Google News RSS trends (Phase 1 discovery)
# Provide a comma-separated list of queries/operators.
# Example: "fintech regulation,AML compliance,payment systems regulation"
# Each query is automatically appended with "when:<time_window>".
# GOOGLE_NEWS_QUERIES=
# GOOGLE_NEWS_TIME_WINDOW=7d
# GOOGLE_NEWS_HL=en-US
# GOOGLE_NEWS_GL=US
# GOOGLE_NEWS_CEID=US:en

# Optional domain tag used inside prompts/outputs
# VI_DOMAIN_TAG=fintech-compliance

# Newsletter discovery (Phase 1)
# COLLECT_LIMIT controls how many candidates are collected per run.
# DASHBOARD_PAGE_SIZE controls how many cards appear per dashboard page.
# COLLECT_LIMIT=50
# DASHBOARD_PAGE_SIZE=12

# Hacker News (official API, no key)
# HN_TOP_STORIES_URL=https://hacker-news.firebaseio.com/v0/topstories.json
# HN_ITEM_URL=https://hacker-news.firebaseio.com/v0/item/{id}.json

# AI company RSS feeds (startup sources)
# OPENAI_RSS_URL=https://openai.com/news/rss.xml
# ANTHROPIC_RSS_URL=https://anthropic.com/news/feed_anthropic.xml
# HF_RSS_URL=https://huggingface.co/blog/feed.xml

# Latest trends (optional Google News headlines)
# ENABLE_GOOGLE_NEWS=1

# Google Alerts RSS (optional)
# Google Alerts -> create alerts -> grab the RSS feed URLs and list them here.
# GOOGLE_ALERTS_RSS_FEEDS=https://www.google.com/alerts/feeds/xxxx?alt=rss,https://www.google.com/alerts/feeds/yyyy?alt=rss

# Dashboard settings
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8501

# ── Publishing integrations (Phase 2) ───────────────────────────────────────

# Ghost CMS (Admin API v4+)
# 1. Ghost Admin → Integrations → Add custom integration
# 2. Copy the "Admin API Key" (format: key_id:hex_secret)
# GHOST_ADMIN_URL=https://your-blog.ghost.io
# GHOST_ADMIN_API_KEY=64f1234abcd:0123456789abcdef...

# WordPress REST API (Application Passwords — built-in since WP 5.6)
# 1. WP Admin → Users → Profile → scroll to Application Passwords
# 2. Create a new one and paste it here (spaces in the key are fine)
# WORDPRESS_SITE_URL=https://your-site.com
# WORDPRESS_USERNAME=admin
# WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# GCP Cloud Scheduler secret (Phase 3)
# Any random string — set same value in Cloud Scheduler HTTP header X-Scheduler-Secret
# SCHEDULER_SECRET=change-me-to-something-random
